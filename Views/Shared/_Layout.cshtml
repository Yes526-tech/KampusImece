@{
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Events";
    var activeAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var isMapPage = activeController == "Events" && activeAction == "Index";
}
<!DOCTYPE html>
<html lang="tr" class="h-full @(isMapPage ? "overflow-hidden" : "")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kampüsİmece</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Anında Karanlık Mod Kontrolü (FOUC Önleme) -->
    <script>
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Leaflet.js CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <style>
        .leaflet-pane { z-index: 10 !important; }
        .leaflet-top, .leaflet-bottom { z-index: 15 !important; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
        .dark ::-webkit-scrollbar-thumb { background: #334155; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .dark .leaflet-tile-pane {
            filter: brightness(0.85) contrast(1.1);
        }
    </style>
</head>
<body data-authenticated="@(User.Identity?.IsAuthenticated == true ? "true" : "false")" class="flex flex-col h-full font-sans antialiased text-slate-800 dark:text-slate-100 bg-[#f8fafc] dark:bg-slate-950 selection:bg-emerald-500 selection:text-white transition-colors duration-200 @(isMapPage ? "overflow-hidden" : "min-h-full")">

    <!-- MODERN YEŞİL & BEYAZ NAVBAR -->
    <header class="sticky top-0 z-50 w-full shrink-0 h-16 bg-emerald-600 dark:bg-[#064e3b] border-b border-emerald-500/40 dark:border-emerald-900/60 shadow-sm transition-colors text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">

                <!-- SOL: Marka & Logo (Yeşil & Beyaz) -->
                <div class="flex items-center gap-3">
                    <a asp-controller="Events" asp-action="Index" class="flex items-center gap-2.5 group">
                        <div class="w-8 h-8 rounded-xl bg-white text-emerald-700 flex items-center justify-center shadow-sm transition-transform group-hover:scale-105">
                            <i data-lucide="sprout" class="w-4 h-4 text-emerald-700"></i>
                        </div>
                        <div class="flex items-baseline gap-1">
                            <span class="text-lg font-bold tracking-tight text-white">Kampüs<span class="text-emerald-200">İmece</span></span>
                            <span class="text-[10px] font-medium text-emerald-100/70 hidden sm:inline">selçuk</span>
                        </div>
                    </a>
                </div>

                <!-- ORTA: Modern Yeşil & Beyaz Menü -->
                <nav class="hidden md:flex items-center gap-1.5">
                    <a asp-controller="Events" asp-action="Index" 
                       class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-medium transition @(activeController == "Events" ? "bg-white/20 text-white font-semibold backdrop-blur-sm shadow-sm" : "text-white/80 hover:text-white hover:bg-white/10")">
                        <i data-lucide="map" class="w-3.5 h-3.5 @(activeController == "Events" ? "text-white" : "text-emerald-200")"></i>
                        <span>Harita & İlanlar</span>
                    </a>
                    <a asp-controller="Leaderboard" asp-action="Index" 
                       class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-medium transition @(activeController == "Leaderboard" ? "bg-white/20 text-white font-semibold backdrop-blur-sm shadow-sm" : "text-white/80 hover:text-white hover:bg-white/10")">
                        <i data-lucide="trophy" class="w-3.5 h-3.5 @(activeController == "Leaderboard" ? "text-amber-300" : "text-emerald-200")"></i>
                        <span>Liderlik Sıralaması</span>
                    </a>
                    @if (User.IsInRole("Coordinator"))
                    {
                        <a asp-controller="Admin" asp-action="Index" 
                           class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-medium transition @(activeController == "Admin" ? "bg-amber-400 text-slate-900 font-bold shadow-sm" : "bg-amber-400/20 text-amber-200 hover:bg-amber-400/30 border border-amber-300/30")">
                            <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                            <span>Yönetim Paneli</span>
                        </a>
                    }
                </nav>

                <!-- SAĞ: Tema Geçişi & Kullanıcı Durumu (Mobilde SADECE Gece Modu Görünür) -->
                <div class="flex items-center">
                    
                    <!-- AYDINLIK / KARANLIK MOD BUTONU (Mobilde Sağ Üstte Tek Başına) -->
                    <button type="button" 
                            id="themeToggleBtn" 
                            onclick="toggleTheme()" 
                            title="Karanlık / Aydınlık Mod" 
                            class="p-2 rounded-xl text-white/90 hover:text-white hover:bg-white/15 transition active:scale-95">
                        <i data-lucide="sun" class="w-5 h-5 hidden dark:block text-amber-300"></i>
                        <i data-lucide="moon" class="w-5 h-5 block dark:hidden text-white"></i>
                    </button>

                    <!-- MASAÜSTÜ GİRİŞ & PROFİL ALANI (Mobilde Gizli: hidden md:flex) -->
                    <div class="hidden md:flex items-center gap-2.5 ml-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button type="button" 
                                    onclick="if(window.openCreateModal){ window.openCreateModal(); } else { window.location.href='/?openModal=true'; }" 
                                    class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-bold text-emerald-800 bg-white hover:bg-emerald-50 transition shadow-sm active:scale-95">
                                <i data-lucide="plus" class="w-3.5 h-3.5 text-emerald-700"></i>
                                <span>Kirlilik Bildir</span>
                            </button>

                            <div class="flex items-center gap-2 pl-2 border-l border-white/20">
                                <div class="w-8 h-8 rounded-xl bg-white/20 text-white font-bold text-xs flex items-center justify-center border border-white/30 backdrop-blur-sm">
                                    @(User.Identity.Name?.Split(' ').Select(x => x[0]).Take(2).Aggregate("", (c, n) => c + n))
                                </div>
                                <div class="hidden lg:flex flex-col text-left">
                                    <span class="text-xs font-semibold text-white leading-tight">@User.Identity.Name</span>
                                    @if (User.IsInRole("Coordinator"))
                                    {
                                        <a asp-controller="Admin" asp-action="Index" class="text-[10px] text-amber-200 hover:text-white font-medium hover:underline flex items-center gap-0.5">
                                            <span>Koordinatör (Panel)</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] text-emerald-100/80">Gönüllü</span>
                                    }
                                </div>

                                <form asp-controller="Auth" asp-action="Logout" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" 
                                            title="Güvenli Çıkış"
                                            class="p-1.5 rounded-xl text-white/80 hover:text-white hover:bg-white/15 transition">
                                        <i data-lucide="log-out" class="w-4 h-4"></i>
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" 
                               class="px-3 py-1.5 rounded-xl text-xs font-medium text-white/90 hover:text-white hover:bg-white/10 transition">
                                Giriş Yap
                            </a>
                            <a asp-controller="Auth" asp-action="Register" 
                               class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-emerald-800 bg-white hover:bg-emerald-50 transition shadow-sm active:scale-95">
                                Gönüllü Ol
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- ANA İÇERİK ALANI -->
    <main class="flex-1 min-h-0 w-full @(isMapPage ? "max-w-[1920px] mx-auto px-2 sm:px-4 lg:px-6 py-2 overflow-hidden flex flex-col pb-16 md:pb-2" : "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 pb-24 md:pb-6")">
        @RenderBody()
    </main>

    <!-- MINIMALIST FOOTER -->
    <footer class="@(isMapPage ? "hidden" : "border-t border-slate-200/70 dark:border-slate-800 bg-white dark:bg-slate-900 mt-auto transition-colors")">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span>© 2026 Kampüsİmece — Selçuk Üniversitesi Topluma Hizmet Projesi</span>
                </div>
                <div class="flex items-center gap-4 text-xs font-medium">
                    <button type="button" onclick="openGlobalKvkkModal('kvkk')" class="text-slate-600 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 transition">
                        KVKK Aydınlatma
                    </button>
                    <span class="text-slate-300 dark:text-slate-700">·</span>
                    <button type="button" onclick="openGlobalKvkkModal('consent')" class="text-slate-600 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 transition">
                        Açık Rıza Beyanı
                    </button>
                    <span class="text-slate-300 dark:text-slate-700">·</span>
                    <button type="button" onclick="openGlobalKvkkModal('cookie')" class="text-slate-600 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 transition">
                        Çerezler
                    </button>
                </div>
            </div>
        </div>
    </footer>

    <!-- ======================================================== -->
    <!-- MODERN MOBİL ALT GEZİNME ÇUBUĞU (TAM 5 BUTONLU MİMARİ)   -->
    <!-- SOL 2: HARİTA, İLANLAR | ORTA: İLAN VER (+) | SAĞ 2: SIRALAMA, PROFİL -->
    <!-- ======================================================== -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl border-t border-slate-200/80 dark:border-slate-800 shadow-[0_-4px_25px_rgba(0,0,0,0.06)] px-2 py-1.5 transition-colors">
        <div class="flex items-center justify-around max-w-md mx-auto relative">
            
            <!-- 1. SOL 1: HARİTA (Ana Menü - Tam Ekran Harita) -->
            <button type="button" 
                    id="mobileNavMapBtn" 
                    onclick="handleMobileNavTab('map')" 
                    class="flex-1 flex flex-col items-center justify-center py-1 transition-all active:scale-95 text-emerald-600 dark:text-emerald-400 font-bold">
                <div class="relative">
                    <i data-lucide="map" class="w-5 h-5 stroke-[2.5]"></i>
                    <span id="mobileNavMapIndicator" class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400"></span>
                </div>
                <span class="text-[10px] mt-1 font-medium">Harita</span>
            </button>

            <!-- 2. SOL 2: İLANLAR (Kartlar / Akış Görünümü) -->
            <button type="button" 
                    id="mobileNavCardsBtn" 
                    onclick="handleMobileNavTab('cards')" 
                    class="flex-1 flex flex-col items-center justify-center py-1 transition-all active:scale-95 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200">
                <div class="relative">
                    <i data-lucide="layout-grid" class="w-5 h-5 stroke-2"></i>
                    <span id="mobileNavCardsIndicator" class="hidden absolute -bottom-1 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400"></span>
                </div>
                <span class="text-[10px] mt-1 font-medium">İlanlar</span>
            </button>

            <!-- 3. ORTA: İLAN VER (+) (Öne Çıkan Yuvarlak Buton) -->
            <div class="flex-1 flex flex-col items-center justify-center -mt-5">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button type="button" 
                            onclick="if(window.openCreateModal){ window.openCreateModal(); } else { window.location.href='/?openModal=true'; }" 
                            title="İlan Ver" 
                            class="w-12 h-12 rounded-full bg-gradient-to-tr from-emerald-600 to-teal-500 text-white shadow-lg shadow-emerald-600/40 flex items-center justify-center border-4 border-[#f8fafc] dark:border-slate-950 active:scale-90 transition-transform">
                        <i data-lucide="plus" class="w-6 h-6 stroke-[2.5]"></i>
                    </button>
                }
                else
                {
                    <button type="button" 
                            onclick="openMobileProfileDrawer()" 
                            title="Giriş Yap ve İlan Ver" 
                            class="w-12 h-12 rounded-full bg-gradient-to-tr from-emerald-600 to-teal-500 text-white shadow-lg shadow-emerald-600/40 flex items-center justify-center border-4 border-[#f8fafc] dark:border-slate-950 active:scale-90 transition-transform">
                        <i data-lucide="plus" class="w-6 h-6 stroke-[2.5]"></i>
                    </button>
                }
                <span class="text-[9px] font-semibold text-emerald-700 dark:text-emerald-400 mt-0.5">İlan Ver</span>
            </div>

            <!-- 4. SAĞ 1: SIRALAMA (Liderlik Tablosu) -->
            <a asp-controller="Leaderboard" asp-action="Index" 
               class="flex-1 flex flex-col items-center justify-center py-1 transition-all active:scale-95 @(activeController == "Leaderboard" ? "text-amber-500 dark:text-amber-400 font-bold" : "text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200")">
                <div class="relative">
                    <i data-lucide="trophy" class="w-5 h-5 @(activeController == "Leaderboard" ? "stroke-[2.5]" : "stroke-2")"></i>
                    @if (activeController == "Leaderboard")
                    {
                        <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                    }
                </div>
                <span class="text-[10px] mt-1 font-medium">Sıralama</span>
            </a>

            <!-- 5. SAĞ 2: PROFİL / GİRİŞ -->
            <button type="button" 
                    onclick="openMobileProfileDrawer()" 
                    class="flex-1 flex flex-col items-center justify-center py-1 transition-all active:scale-95 text-slate-500 dark:text-slate-400 hover:text-emerald-600">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="w-6 h-6 rounded-full bg-emerald-600 text-white font-bold text-[10px] flex items-center justify-center ring-2 ring-emerald-500/30">
                        @(User.Identity.Name?.Split(' ').Select(x => x[0]).Take(2).Aggregate("", (c, n) => c + n))
                    </div>
                    <span class="text-[10px] mt-0.5 font-medium truncate max-w-[48px]">Profil</span>
                }
                else
                {
                    <i data-lucide="user" class="w-5 h-5"></i>
                    <span class="text-[10px] mt-1 font-medium">Giriş</span>
                }
            </button>
        </div>
    </nav>

    <!-- ======================================================== -->
    <!-- MOBİL PROFİL & HESAP DRAWER (Açılır Alt Menü)            -->
    <!-- ======================================================== -->
    <div id="mobileProfileDrawer" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm transition-opacity" onclick="closeMobileProfileDrawer()">
        <div class="fixed bottom-0 left-0 right-0 max-w-lg mx-auto bg-white dark:bg-slate-900 rounded-t-3xl border-t border-slate-200 dark:border-slate-800 p-5 pb-8 shadow-2xl transition-transform" onclick="event.stopPropagation()">
            <div class="w-10 h-1 bg-slate-300 dark:bg-slate-700 rounded-full mx-auto mb-4"></div>
            
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="flex items-center gap-3 pb-4 border-b border-slate-100 dark:border-slate-800">
                    <div class="w-12 h-12 rounded-2xl bg-emerald-600 text-white font-bold text-base flex items-center justify-center shadow-md shadow-emerald-600/30">
                        @(User.Identity.Name?.Split(' ').Select(x => x[0]).Take(2).Aggregate("", (c, n) => c + n))
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="text-sm font-bold text-slate-900 dark:text-white truncate">@User.Identity.Name</h4>
                        <div class="flex items-center gap-1.5 mt-0.5">
                            @if (User.IsInRole("Coordinator"))
                            {
                                <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                                    Koordinatör
                                </span>
                            }
                            else
                            {
                                <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                                    Gönüllü Üye
                                </span>
                            }
                        </div>
                    </div>
                    <button type="button" onclick="closeMobileProfileDrawer()" class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-xl">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>

                <div class="py-3 space-y-1 text-xs">
                    @if (User.IsInRole("Coordinator"))
                    {
                        <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-3 p-3 rounded-xl bg-amber-50 dark:bg-amber-950/30 text-amber-800 dark:text-amber-300 font-semibold border border-amber-200 dark:border-amber-900">
                            <i data-lucide="shield-check" class="w-4 h-4 text-amber-600"></i>
                            <span class="flex-1">Koordinatör Yönetim Paneli</span>
                            <i data-lucide="chevron-right" class="w-4 h-4 text-amber-400"></i>
                        </a>
                    }
                    <a asp-controller="Events" asp-action="Index" class="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 font-medium transition">
                        <i data-lucide="map-pin" class="w-4 h-4 text-emerald-600"></i>
                        <span class="flex-1">Kampüs İlanları ve Harita</span>
                    </a>
                    <a asp-controller="Leaderboard" asp-action="Index" class="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 font-medium transition">
                        <i data-lucide="trophy" class="w-4 h-4 text-amber-500"></i>
                        <span class="flex-1">Gönüllü Liderlik Tablosu</span>
                    </a>
                    <button type="button" onclick="openGlobalKvkkModal('kvkk'); closeMobileProfileDrawer();" class="w-full flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 font-medium transition text-left">
                        <i data-lucide="file-text" class="w-4 h-4 text-blue-500"></i>
                        <span class="flex-1">KVKK ve Gizlilik Politikası</span>
                    </button>
                </div>

                <div class="pt-2">
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="w-full">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full py-2.5 rounded-xl border border-rose-200 dark:border-rose-900 bg-rose-50/80 dark:bg-rose-950/30 text-rose-600 dark:text-rose-400 font-semibold text-xs flex items-center justify-center gap-2 active:scale-98 transition">
                            <i data-lucide="log-out" class="w-4 h-4"></i>
                            <span>Güvenli Çıkış Yap</span>
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="text-center py-2">
                    <div class="w-12 h-12 rounded-2xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 mx-auto flex items-center justify-center mb-3 shadow-inner">
                        <i data-lucide="user-plus" class="w-6 h-6"></i>
                    </div>
                    <h4 class="text-base font-bold text-slate-900 dark:text-white">Kampüsİmece'ye Katılın</h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-xs mx-auto">Kampüsteki çevre hareketine katılmak veya yeni kirlilik noktası bildirmek için giriş yapın.</p>
                    
                    <div class="mt-5 space-y-2.5">
                        <a asp-controller="Auth" asp-action="Login" class="w-full py-2.5 rounded-xl bg-emerald-600 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-sm active:scale-98 transition">
                            <i data-lucide="log-in" class="w-4 h-4"></i>
                            <span>Giriş Yap</span>
                        </a>
                        <a asp-controller="Auth" asp-action="Register" class="w-full py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold text-xs flex items-center justify-center gap-2 active:scale-98 transition">
                            <i data-lucide="sparkles" class="w-4 h-4 text-emerald-600"></i>
                            <span>Yeni Gönüllü Kaydı Aç</span>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- GLOBAL MINIMAL KVKK MODAL -->
    <div id="globalKvkkModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 overflow-y-auto">
        <div class="relative w-full max-w-xl bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-800 overflow-hidden my-8">
            <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-2">
                    <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white" id="globalKvkkModalTitle">KVKK Aydınlatma Metni</h3>
                </div>
                <button type="button" onclick="closeGlobalKvkkModal()" class="p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <!-- Tab Seçimi -->
            <div class="flex border-b border-slate-100 dark:border-slate-800 px-5 pt-2 gap-2 text-xs font-medium bg-slate-50/50 dark:bg-slate-850">
                <button type="button" id="tabBtnKvkk" onclick="switchGlobalKvkkTab('kvkk')" 
                        class="pb-2 px-2.5 border-b-2 border-emerald-600 text-slate-900 dark:text-white font-semibold transition">
                    Aydınlatma Metni
                </button>
                <button type="button" id="tabBtnConsent" onclick="switchGlobalKvkkTab('consent')" 
                        class="pb-2 px-2.5 border-b-2 border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition">
                    Açık Rıza Beyanı
                </button>
                <button type="button" id="tabBtnCookie" onclick="switchGlobalKvkkTab('cookie')" 
                        class="pb-2 px-2.5 border-b-2 border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition">
                    Çerez Politikası
                </button>
            </div>

            <!-- İçerik -->
            <div class="p-5 space-y-3.5 max-h-[55vh] overflow-y-auto text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                <div id="tabContentKvkk" class="space-y-3">
                    <div class="p-3 bg-emerald-50/80 dark:bg-emerald-950/40 rounded-xl border border-emerald-100 dark:border-emerald-900 text-emerald-900 dark:text-emerald-200">
                        Bu bilgilendirme, 6698 sayılı KVKK Madde 10 gereği hazırlanmıştır.
                    </div>
                    <div>
                        <h4 class="font-semibold text-slate-900 dark:text-white text-xs mb-1">1. Veri Sorumlusu</h4>
                        <p>Selçuk Üniversitesi Kampüsİmece Topluma Hizmet Platformu.</p>
                    </div>
                    <div>
                        <h4 class="font-semibold text-slate-900 dark:text-white text-xs mb-1">2. İşlenen Veriler</h4>
                        <p>Ad Soyad, Öğrenci No, Kurumsal E-posta (@@ogr.selcuk.edu.tr), gönüllülük etkinlik katılım kayıtları ve saha temizlik fotoğrafları.</p>
                    </div>
                    <div>
                        <h4 class="font-semibold text-slate-900 dark:text-white text-xs mb-1">3. Güvenlik & Kriptografik Koruma</h4>
                        <p>Kişisel şifreler PBKDF2-SHA256 ile tuzlanarak saklanır. Öğrenci numaraları kamuya açık tablolarda otomatik olarak maskelenir. Onayınız SHA-256 denetim iziyle PostgreSQL veritabanımızda güvence altındadır.</p>
                    </div>
                </div>

                <div id="tabContentConsent" class="hidden space-y-3">
                    <p>Kampüsİmece platformuna kayıt olurken paylaştığım verilerimin çevre ve gönüllülük faaliyetlerinin koordinasyonu amacıyla 6698 sayılı Kanun kapsamında işlenmesine açık rızam ile izin veriyorum.</p>
                </div>

                <div id="tabContentCookie" class="hidden space-y-3">
                    <p>Platformumuzda yalnızca güvenli oturum ve CSRF koruması için zorunlu teknik çerezler kullanılmaktadır. Üçüncü taraf reklam çerezi bulunmaz.</p>
                </div>
            </div>

            <div class="flex items-center justify-end px-5 py-3 border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-850">
                <button type="button" onclick="closeGlobalKvkkModal()" class="px-3.5 py-1.5 rounded-lg bg-slate-900 dark:bg-slate-800 text-white text-xs font-medium hover:bg-slate-800 dark:hover:bg-slate-700 transition">
                    Kapat
                </button>
            </div>
        </div>
    </div>

    <!-- MINIMALIST COOKIE BANNER -->
    <div id="cookieConsentBanner" class="fixed bottom-4 inset-x-4 sm:inset-x-auto sm:right-4 max-w-sm z-40 hidden bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 shadow-lg">
        <div class="flex items-start gap-2.5">
            <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5"></i>
            <div class="text-xs text-slate-600 dark:text-slate-300 leading-normal">
                <p class="font-medium text-slate-900 dark:text-white mb-1">Gizlilik ve Teknik Çerezler</p>
                Platformumuzda sadece oturum ve form güvenliği için zorunlu çerezler kullanılır.
                <div class="mt-2.5 flex items-center gap-2">
                    <button type="button" onclick="acceptCookieConsent()" class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-medium transition">
                        Anladım
                    </button>
                    <button type="button" onclick="openGlobalKvkkModal('cookie')" class="text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white text-xs">
                        Detaylar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- TOAST NOTIFICATIONS -->
    <div id="toastContainer" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <script>
        // Tema Değiştirici (Dark / Light Mode)
        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            if (window.lucide) lucide.createIcons();
        }

        // Mobil Alt Navbar Sekme Yöneticisi (Harita vs İlanlar)
        function handleMobileNavTab(tab) {
            const isHomePage = window.location.pathname === '/' || 
                               window.location.pathname.toLowerCase() === '/events' || 
                               window.location.pathname.toLowerCase() === '/events/index';
            if (isHomePage && typeof window.switchMobileTab === 'function') {
                window.switchMobileTab(tab);
                try {
                    history.replaceState(null, '', tab === 'cards' ? '/?view=cards' : '/');
                } catch(e) {}
            } else {
                window.location.href = tab === 'cards' ? '/?view=cards' : '/';
            }
        }

        // Mobil Profil / Giriş Menüsü Açma & Kapatma
        function openMobileProfileDrawer() {
            const drawer = document.getElementById('mobileProfileDrawer');
            if (drawer) {
                drawer.classList.remove('hidden');
                if (window.lucide) lucide.createIcons();
            }
        }

        function closeMobileProfileDrawer() {
            const drawer = document.getElementById('mobileProfileDrawer');
            if (drawer) {
                drawer.classList.add('hidden');
            }
        }

        function openGlobalKvkkModal(tab = 'kvkk') {
            const modal = document.getElementById('globalKvkkModal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.classList.add('overflow-hidden');
                switchGlobalKvkkTab(tab);
            }
        }

        function closeGlobalKvkkModal() {
            const modal = document.getElementById('globalKvkkModal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.classList.remove('overflow-hidden');
            }
        }

        function switchGlobalKvkkTab(tab) {
            const tabs = ['kvkk', 'consent', 'cookie'];
            tabs.forEach(t => {
                const btn = document.getElementById('tabBtn' + t.charAt(0).toUpperCase() + t.slice(1));
                const content = document.getElementById('tabContent' + t.charAt(0).toUpperCase() + t.slice(1));
                if (btn && content) {
                    if (t === tab) {
                        btn.className = 'pb-2 px-2.5 border-b-2 border-emerald-600 text-slate-900 dark:text-white font-semibold transition';
                        content.classList.remove('hidden');
                    } else {
                        btn.className = 'pb-2 px-2.5 border-b-2 border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition';
                        content.classList.add('hidden');
                    }
                }
            });
        }

        function checkCookieConsent() {
            if (!localStorage.getItem('kampus_cookie_consent')) {
                const banner = document.getElementById('cookieConsentBanner');
                if (banner) banner.classList.remove('hidden');
            }
        }

        function acceptCookieConsent() {
            localStorage.setItem('kampus_cookie_consent', 'true');
            const banner = document.getElementById('cookieConsentBanner');
            if (banner) banner.classList.add('hidden');
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (window.lucide) lucide.createIcons();
            checkCookieConsent();

            @if (TempData["SuccessMessage"] != null)
            {
                <text>window.showToast("@TempData["SuccessMessage"]", "success");</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>window.showToast("@TempData["ErrorMessage"]", "error");</text>
            }
        });

        window.showToast = function (message, type = 'success') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const isSuccess = type === 'success';
            const iconName = isSuccess ? 'check-circle-2' : (type === 'error' ? 'alert-triangle' : 'info');
            const iconColor = isSuccess ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400';

            const toast = document.createElement('div');
            toast.className = `pointer-events-auto flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl shadow-md border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900 max-w-sm text-xs font-medium text-slate-700 dark:text-slate-200 transform translate-y-2 opacity-0 transition-all duration-200`;
            toast.innerHTML = `
                <i data-lucide="${iconName}" class="w-4 h-4 ${iconColor} shrink-0"></i>
                <span class="flex-1">${message}</span>
                <button onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 ml-1">
                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                </button>
            `;

            container.appendChild(toast);
            if (window.lucide) lucide.createIcons();

            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 250);
            }, 4500);
        };
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>