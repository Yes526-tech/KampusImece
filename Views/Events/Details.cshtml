@model KampusImece.Models.Entities.CleanupEvent
@{
    ViewData["Title"] = Model.Title + " - İlan Detayı";

    var isCompleted = Model.Status == KampusImece.Models.Entities.EventStatus.Completed;
    var isFull = Model.Participations.Count >= Model.RequiredVolunteers || Model.Status == KampusImece.Models.Entities.EventStatus.QuotaFull;
    var remaining = Math.Max(0, Model.RequiredVolunteers - Model.Participations.Count);
    var percent = Model.RequiredVolunteers > 0 ? Math.Min(100, (int)Math.Round((double)Model.Participations.Count / Model.RequiredVolunteers * 100)) : 0;

    bool hasJoined = ViewBag.HasJoined == true;
    bool isCreator = ViewBag.IsCreator == true;
    bool canComplete = ViewBag.CanComplete == true;
}

@Html.AntiForgeryToken()

<div class="max-w-6xl mx-auto space-y-6">

    <!-- ÜST NAVİGASYON & GERİ DÖN -->
    <div class="flex items-center justify-between flex-wrap gap-3">
        <a href="/" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-emerald-500/30 transition shadow-sm active:scale-95">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            <span>Harita & İlanlara Dön</span>
        </a>

        <!-- Durum Rozetleri -->
        <div class="flex items-center gap-2">
            @if (isCompleted)
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-bold bg-emerald-600 text-white shadow-sm">
                    <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                    <span>Temizlik Kanıtlandı & Tamamlandı</span>
                </span>
            }
            else if (isFull)
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-bold bg-slate-800 text-white shadow-sm">
                    <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                    <span>Kontenjan Dolu (@Model.RequiredVolunteers Gönüllü)</span>
                </span>
            }
            else
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-bold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>@remaining Gönüllü Aranıyor</span>
                </span>
            }

            <button type="button" 
                    onclick="copyEventShareLink()" 
                    title="İlanı Paylaş" 
                    class="p-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-emerald-500/30 transition shadow-sm active:scale-95">
                <i data-lucide="share-2" class="w-4 h-4"></i>
            </button>
        </div>
    </div>

    <!-- ANA DETAY DÜZENİ: 2 SÜTUNLU MODERN DÜZEN -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <!-- SOL SÜTUN (7/12): FOTOĞRAFLAR, ÖNCESİ/SONRASI & KAMPÜS MİNİ HARİTASI -->
        <div class="lg:col-span-7 space-y-6">

            <!-- FOTOĞRAF KARTI (ÖNCESİ / SONRASI KONTROLÜ DAHİL) -->
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm transition-colors">
                <div class="relative w-full h-80 sm:h-96 bg-slate-900 overflow-hidden group">
                    <img id="detailHeroImage" 
                         src="@(isCompleted && !string.IsNullOrEmpty(Model.AfterImageUrl) ? Model.AfterImageUrl : Model.ImageUrl)" 
                         alt="@Model.Title" 
                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />

                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent pointer-events-none"></div>

                    <!-- Sol Alt Etiket: Konum Adı -->
                    <div class="absolute bottom-4 left-4 z-10 flex items-center gap-2">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-black/60 backdrop-blur-md text-white shadow-sm border border-white/10">
                            <i data-lucide="map-pin" class="w-3.5 h-3.5 text-emerald-400 shrink-0"></i>
                            <span>@Model.LocationName</span>
                        </span>
                    </div>

                    <!-- Sağ Alt Öncesi / Sonrası Değiştirici -->
                    @if (isCompleted && !string.IsNullOrEmpty(Model.AfterImageUrl))
                    {
                        <div class="absolute bottom-4 right-4 z-10 flex items-center bg-black/70 backdrop-blur-md p-1 rounded-xl border border-white/20 shadow-lg text-xs font-semibold">
                            <button type="button" 
                                    id="btnToggleBefore" 
                                    onclick="switchDetailPhoto('before')" 
                                    class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white transition">
                                Öncesi
                            </button>
                            <button type="button" 
                                    id="btnToggleAfter" 
                                    onclick="switchDetailPhoto('after')" 
                                    class="px-3 py-1.5 rounded-lg bg-emerald-600 text-white shadow">
                                Sonrası ✨
                            </button>
                        </div>
                    }
                </div>

                <!-- Fotoğraf Alt Notu -->
                <div class="p-4 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 border-t border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2">
                        <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600"></i>
                        <span>Doğrulanmış Saha Fotoğrafı</span>
                    </div>
                    <span>Tarih: @Model.CreatedAt.ToString("dd MMMM yyyy HH:mm", new System.Globalization.CultureInfo("tr-TR"))</span>
                </div>
            </div>

            <!-- TAMAMLANMA VE KANIT BİLGİ KARTI (Eğer Tamamlandıysa) -->
            @if (isCompleted)
            {
                <div class="bg-emerald-50/70 dark:bg-emerald-950/30 rounded-2xl border border-emerald-200/80 dark:border-emerald-800/60 p-5 shadow-sm">
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 shadow-md shadow-emerald-600/30">
                            <i data-lucide="check-check" class="w-5 h-5 stroke-[2.5]"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between gap-2 flex-wrap mb-1">
                                <h4 class="text-sm font-bold text-emerald-900 dark:text-emerald-200">Temizlik İmecesi Başarıyla Tamamlandı!</h4>
                                <span class="px-2.5 py-0.5 rounded-lg bg-emerald-600 text-white text-[11px] font-bold">+30 Puan Kazanıldı</span>
                            </div>
                            <p class="text-xs text-emerald-800 dark:text-emerald-300 leading-relaxed mb-3">
                                @(string.IsNullOrWhiteSpace(Model.CompletionNote) ? "Gönüllü öğrencilerimiz bir araya gelerek kirlilik alanını tamamen temizlemiş ve çevreye kazandırmıştır." : Model.CompletionNote)
                            </p>
                            @if (Model.CompletedAt.HasValue)
                            {
                                <div class="text-[11px] text-emerald-700/80 dark:text-emerald-400 flex items-center gap-1.5">
                                    <i data-lucide="clock" class="w-3.5 h-3.5"></i>
                                    <span>Tamamlanma Zamanı: @Model.CompletedAt.Value.ToString("dd MMMM yyyy HH:mm", new System.Globalization.CultureInfo("tr-TR"))</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- MİNİ LEAFLET KAMPÜS HARİTASI (NOKTA KONUMU) -->
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-4 shadow-sm transition-colors">
                <div class="flex items-center justify-between mb-3 text-xs">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        <h4 class="font-bold text-slate-900 dark:text-white">Tam Konum Koordinatları</h4>
                    </div>
                    <span class="font-mono text-[11px] text-slate-500 dark:text-slate-400">@Model.Latitude.ToString("F4"), @Model.Longitude.ToString("F4")</span>
                </div>

                <div id="detailSpotMap" class="w-full h-64 rounded-xl border border-slate-100 dark:border-slate-800 overflow-hidden"></div>

                <div class="mt-3 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                    <span class="flex items-center gap-1">
                        <i data-lucide="map" class="w-3.5 h-3.5 text-emerald-600"></i>
                        <span>Alaaddin Keykubat Kampüsü</span>
                    </span>
                    <a href="https://www.google.com/maps/dir/?api=1&destination=@Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture),@Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                       target="_blank" 
                       rel="noopener noreferrer" 
                       class="text-emerald-600 dark:text-emerald-400 hover:underline font-semibold flex items-center gap-1">
                        <span>Yol Tarifi Al</span>
                        <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                    </a>
                </div>
            </div>

        </div>

        <!-- SAĞ SÜTUN (5/12): BAŞLIK, AÇIKLAMA, GÖNÜLLÜ KONTENJANI, KATILIMCILAR & İŞLEMLER -->
        <div class="lg:col-span-5 space-y-6">

            <!-- BAŞLIK & İLAN BİLGİ KARTI -->
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5 shadow-sm transition-colors space-y-4">
                
                <!-- Başlık -->
                <div>
                    <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white leading-tight">
                        @Model.Title
                    </h1>
                    <div class="flex items-center gap-2 mt-2 text-xs text-slate-500 dark:text-slate-400">
                        <span class="flex items-center gap-1">
                            <i data-lucide="calendar" class="w-3.5 h-3.5 text-emerald-600"></i>
                            <span>Buluşma: @Model.ScheduledAt.ToString("dd MMMM yyyy HH:mm", new System.Globalization.CultureInfo("tr-TR"))</span>
                        </span>
                    </div>
                </div>

                <!-- Açıklama -->
                <div class="pt-2 border-t border-slate-100 dark:border-slate-800">
                    <h4 class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Kirlilik Durumu & Çağrı</h4>
                    <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed whitespace-pre-line">
                        @Model.Description
                    </p>
                </div>

                <!-- İlan Sahibi -->
                <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-slate-800 dark:bg-slate-700 text-white font-bold text-xs flex items-center justify-center shadow-sm">
                            @(Model.Creator.FullName.Split(' ').Select(x => x[0]).Take(2).Aggregate("", (c, n) => c + n))
                        </div>
                        <div>
                            <span class="text-xs font-bold text-slate-900 dark:text-white block">@Model.Creator.FullName</span>
                            <span class="text-[11px] text-emerald-700 dark:text-emerald-400 font-medium">İlanı Oluşturan Öğrenci</span>
                        </div>
                    </div>
                    <span class="text-[11px] text-slate-400">@Model.CreatedAt.ToString("dd.MM.yyyy")</span>
                </div>
            </div>

            <!-- GÖNÜLLÜ KONTENJANI VE İLERLEME -->
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5 shadow-sm transition-colors space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <i data-lucide="users" class="w-4 h-4 text-emerald-600"></i>
                        <h4 class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider">Gönüllü İmecesi Durumu</h4>
                    </div>
                    <span class="text-sm font-bold @(isCompleted ? "text-emerald-600" : (isFull ? "text-amber-500" : "text-emerald-600"))">
                        @(isCompleted ? "Tamamlandı" : $"{Model.Participations.Count} / {Model.RequiredVolunteers} Kişi")
                    </span>
                </div>

                <!-- İlerleme Çubuğu -->
                <div class="space-y-1.5">
                    <div class="w-full h-2.5 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                        <div id="detailsProgressBar" 
                             class="h-full rounded-full transition-all duration-500 @(isCompleted ? "bg-emerald-600" : (isFull ? "bg-amber-500" : "bg-emerald-500"))" 
                             style="width: @(isCompleted ? "100" : percent.ToString())%"></div>
                    </div>
                    <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
                        <span>Hedef: @Model.RequiredVolunteers Gönüllü</span>
                        <span id="detailsRemainingText">@(isCompleted ? "Görev tamamlandı" : (isFull ? "Kontenjan doldu" : $"{remaining} kişilik yer var"))</span>
                    </div>
                </div>

                <!-- KATILIMCILAR LİSTESİ -->
                <div class="pt-3 border-t border-slate-100 dark:border-slate-800">
                    <h5 class="text-xs font-semibold text-slate-800 dark:text-slate-200 mb-2.5 flex items-center justify-between">
                        <span>Katılan Gönüllüler</span>
                        <span class="text-[10px] text-slate-400">(@Model.Participations.Count)</span>
                    </h5>

                    <div id="detailsParticipantsList" class="space-y-2 max-h-48 overflow-y-auto pr-1">
                        @foreach (var part in Model.Participations.OrderBy(p => p.JoinedAt))
                        {
                            <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 text-xs">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    <div class="w-7 h-7 rounded-lg bg-emerald-600/10 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 font-bold text-[11px] flex items-center justify-center shrink-0">
                                        @(part.User.FullName.Split(' ').Select(x => x[0]).Take(2).Aggregate("", (c, n) => c + n))
                                    </div>
                                    <div class="truncate">
                                        <span class="font-semibold text-slate-800 dark:text-slate-100 block truncate">@part.User.FullName</span>
                                        <span class="text-[10px] text-slate-400 block">@part.JoinedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                    </div>
                                </div>
                                @if (part.UserId == Model.CreatorId)
                                {
                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 shrink-0">
                                        Kurucu
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 shrink-0">
                                        Gönüllü
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- AKSİYON VE İŞLEM KARTI (KATIL, KANITLA, SİL, ŞİKAYET ET) -->
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5 shadow-sm transition-colors space-y-3">
                <h4 class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-2">Etkinlik İşlemleri</h4>

                @if (!User.Identity?.IsAuthenticated == true)
                {
                    <a href="/Auth/Login" class="w-full py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition active:scale-95">
                        <i data-lucide="log-in" class="w-4 h-4"></i>
                        <span>Giriş Yap ve Bu İmeceye Katıl</span>
                    </a>
                }
                else
                {
                    @if (isCompleted)
                    {
                        <div class="w-full py-3 px-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 font-semibold text-xs flex items-center justify-center gap-2 border border-emerald-200 dark:border-emerald-800">
                            <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                            <span>Bu temizlik görevi tamamlanmıştır. Teşekkürler!</span>
                        </div>
                    }
                    else
                    {
                        <!-- KATIL / AYRIL BUTONU -->
                        <div class="space-y-2">
                            @if (hasJoined)
                            {
                                <button type="button" 
                                        id="detailsToggleJoinBtn" 
                                        onclick="detailsToggleJoin()" 
                                        class="w-full py-2.5 px-4 rounded-xl border border-rose-200 dark:border-rose-900/60 bg-rose-50/70 dark:bg-rose-950/20 hover:bg-rose-100 text-rose-600 dark:text-rose-400 font-semibold text-xs flex items-center justify-center gap-2 transition active:scale-95">
                                    <i data-lucide="user-minus" class="w-4 h-4"></i>
                                    <span>Katılımı İptal Et</span>
                                </button>
                            }
                            else if (isFull)
                            {
                                <button type="button" 
                                        disabled 
                                        class="w-full py-2.5 px-4 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-400 dark:text-slate-500 font-medium text-xs flex items-center justify-center gap-2 border border-slate-200 dark:border-slate-700 cursor-not-allowed">
                                    <i data-lucide="lock" class="w-4 h-4"></i>
                                    <span>Kontenjan Dolmuştur</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" 
                                        id="detailsToggleJoinBtn" 
                                        onclick="detailsToggleJoin()" 
                                        class="w-full py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition active:scale-95">
                                    <i data-lucide="hand" class="w-4 h-4"></i>
                                    <span>Gönüllü Olarak Katıl (+1)</span>
                                </button>
                            }
                        </div>

                        <!-- KANITLA VE TAMAMLA BUTONU (KURUCU VEYA KATILIMCILAR İÇİN) -->
                        @if (canComplete)
                        {
                            <button type="button" 
                                    onclick="openDetailsCompleteModal()" 
                                    class="w-full py-2.5 px-4 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition active:scale-95">
                                <i data-lucide="camera" class="w-4 h-4"></i>
                                <span>Temizliği Kanıtla & Tamamla (+30 Puan)</span>
                            </button>
                        }

                        <!-- İLANI SİL (YALNIZCA İLAN KURUCUSU) -->
                        @if (isCreator)
                        {
                            <button type="button" 
                                    onclick="detailsDeleteEvent()" 
                                    class="w-full py-2 px-3 rounded-xl border border-rose-200 dark:border-rose-900/60 bg-rose-50/50 dark:bg-rose-950/10 hover:bg-rose-100 text-rose-600 dark:text-rose-400 font-semibold text-xs flex items-center justify-center gap-1.5 transition active:scale-95">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                <span>İlanı Kalıcı Olarak Sil</span>
                            </button>
                        }
                    }
                }

                <!-- ŞİKAYET ET / RAPORLA -->
                <button type="button" 
                        onclick="openDetailsReportModal()" 
                        class="w-full py-2 px-3 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400 font-medium text-xs flex items-center justify-center gap-1.5 transition">
                    <i data-lucide="flag" class="w-3.5 h-3.5 text-rose-500"></i>
                    <span>Moderatöre Bildir / Şikayet Et</span>
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- DETAY SAYFASI: TEMİZLİK KANITI YÜKLEME MODALI            -->
<!-- ======================================================== -->
<div id="detailsCompleteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 overflow-y-auto">
    <div class="relative w-full max-w-lg bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-800 overflow-hidden my-8">
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-2">
                <i data-lucide="sparkles" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white">Temizlik Kanıtı Yükle</h3>
            </div>
            <button type="button" onclick="closeDetailsCompleteModal()" class="p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-lg">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form id="detailsCompleteForm" class="p-5 space-y-4">
            @Html.AntiForgeryToken()
            <div id="detailsCompleteAlert" class="hidden p-2.5 rounded-xl text-xs font-medium border"></div>

            <div>
                <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1">
                    Temizlik Sonrası Kanıt Fotoğrafı *
                </label>
                <input type="file" id="detailsAfterPhoto" accept="image/jpeg,image/png,image/webp" required class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 dark:file:bg-slate-800 dark:file:text-emerald-400" />
                <p class="text-[10px] text-slate-400 mt-1">Lütfen temizlenen alanın net ve aydınlık bir fotoğrafını yükleyiniz (JPG, PNG, WebP - En fazla 5MB).</p>
            </div>

            <div>
                <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1">
                    Temizlik Notu / Açıklama
                </label>
                <textarea id="detailsCompletionNote" rows="3" maxlength="500" placeholder="Örn: 3 torba plastik atık toplandı ve kampüs geri dönüşüm kutularına bırakıldı." class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500"></textarea>
            </div>

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeDetailsCompleteModal()" class="px-3.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs text-slate-600 dark:text-slate-300">
                    Vazgeç
                </button>
                <button type="submit" id="btnSubmitDetailsComplete" class="px-4 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-sm transition active:scale-95 flex items-center gap-1.5">
                    <i data-lucide="check" class="w-3.5 h-3.5"></i>
                    <span>Temizliği Onayla</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ======================================================== -->
<!-- DETAY SAYFASI: ŞİKAYET MODALI                             -->
<!-- ======================================================== -->
<div id="detailsReportModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 overflow-y-auto">
    <div class="relative w-full max-w-md bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-800 overflow-hidden my-8">
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-2">
                <i data-lucide="flag" class="w-4 h-4 text-rose-600 dark:text-rose-400"></i>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white">İlanı Şikayet Et</h3>
            </div>
            <button type="button" onclick="closeDetailsReportModal()" class="p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-lg">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form id="detailsReportForm" class="p-5 space-y-3.5">
            @Html.AntiForgeryToken()
            <div id="detailsReportAlert" class="hidden p-2.5 rounded-xl text-xs font-medium border"></div>

            <div>
                <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1">Şikayet Nedeni *</label>
                <select id="detailsReportReason" required class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500">
                    <option value="">Lütfen bir neden seçiniz...</option>
                    <option value="Sahte Kirlilik Bildirimi">Sahte / Gerçek Dışı Kirlilik Bildirimi</option>
                    <option value="Uygunsuz veya Müstehcen Görsel">Uygunsuz, Hakaret İçeren veya Müstehcen Görsel</option>
                    <option value="Tehlikeli veya Yanlış Konum">Tehlikeli, Ulaşılamaz veya Yanlış Konum</option>
                    <option value="Spam veya Reklam İçeriği">Spam, Reklam veya Çevre Dışı İçerik</option>
                    <option value="Diğer">Diğer</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1">Açıklama</label>
                <textarea id="detailsReportDesc" rows="3" maxlength="1000" placeholder="Şikayetinizi detaylandırınız..." class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500"></textarea>
            </div>

            <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeDetailsReportModal()" class="px-3.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs text-slate-600 dark:text-slate-300">
                    Vazgeç
                </button>
                <button type="submit" id="btnSubmitDetailsReport" class="px-4 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold shadow-sm transition active:scale-95 flex items-center gap-1.5">
                    <i data-lucide="send" class="w-3.5 h-3.5"></i>
                    <span>Şikayeti İlet</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const EVENT_ID = '@Model.Id';
        const BEFORE_IMG = '@Model.ImageUrl';
        const AFTER_IMG = '@(Model.AfterImageUrl ?? "")';
        const EVENT_LAT = @Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const EVENT_LNG = @Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);

        // Fotoğraf Öncesi / Sonrası Geçişi
        function switchDetailPhoto(mode) {
            const heroImg = document.getElementById('detailHeroImage');
            const btnBefore = document.getElementById('btnToggleBefore');
            const btnAfter = document.getElementById('btnToggleAfter');

            if (!heroImg || !btnBefore || !btnAfter) return;

            if (mode === 'before') {
                heroImg.src = BEFORE_IMG;
                btnBefore.className = 'px-3 py-1.5 rounded-lg bg-emerald-600 text-white shadow';
                btnAfter.className = 'px-3 py-1.5 rounded-lg text-slate-300 hover:text-white transition';
            } else {
                heroImg.src = AFTER_IMG || BEFORE_IMG;
                btnAfter.className = 'px-3 py-1.5 rounded-lg bg-emerald-600 text-white shadow';
                btnBefore.className = 'px-3 py-1.5 rounded-lg text-slate-300 hover:text-white transition';
            }
        }

        // Mini Leaflet Haritası
        document.addEventListener('DOMContentLoaded', () => {
            if (window.lucide) lucide.createIcons();

            const mapEl = document.getElementById('detailSpotMap');
            if (mapEl && typeof L !== 'undefined') {
                const map = L.map('detailSpotMap', {
                    zoomControl: true,
                    scrollWheelZoom: false
                }).setView([EVENT_LAT, EVENT_LNG], 16);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '© OpenStreetMap'
                }).addTo(map);

                const pinHtml = `@(isCompleted ? "<div class='w-8 h-8 rounded-full bg-emerald-700 border-2 border-white text-white flex items-center justify-center shadow-lg'><i data-lucide='check' class='w-4 h-4'></i></div>" : "<div class='w-8 h-8 rounded-full bg-emerald-600 border-2 border-white text-white flex items-center justify-center shadow-lg'><i data-lucide='trees' class='w-4 h-4'></i></div>")`;

                const icon = L.divIcon({
                    className: 'detail-pin',
                    html: pinHtml,
                    iconSize: [32, 32],
                    iconAnchor: [16, 16]
                });

                L.marker([EVENT_LAT, EVENT_LNG], { icon: icon })
                    .addTo(map)
                    .bindPopup('<strong>@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Title)</strong><br/><span class="text-xs text-slate-500">@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.LocationName)</span>')
                    .openPopup();

                setTimeout(() => map.invalidateSize(), 250);
            }
        });

        // Paylaş Butonu
        function copyEventShareLink() {
            navigator.clipboard.writeText(window.location.href).then(() => {
                if (window.showToast) window.showToast("İlan bağlantısı panoya kopyalandı!", "success");
            }).catch(() => {
                if (window.showToast) window.showToast("Bağlantı kopyalanamadı.", "error");
            });
        }

        // Gönüllü Katılım / İptal AJAX
        async function detailsToggleJoin() {
            const btn = document.getElementById('detailsToggleJoinBtn');
            if (btn) btn.disabled = true;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const response = await fetch(`/api/events/${EVENT_ID}/toggle-join`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });

                const res = await response.json();
                if (response.ok && res.success) {
                    if (window.showToast) window.showToast(res.message, "success");
                    setTimeout(() => window.location.reload(), 600);
                } else {
                    if (window.showToast) window.showToast(res.message || "İşlem gerçekleştirilemedi.", "error");
                    if (btn) btn.disabled = false;
                }
            } catch (e) {
                if (window.showToast) window.showToast("Sunucu ile iletişim hatası.", "error");
                if (btn) btn.disabled = false;
            }
        }

        // İlanı Sil AJAX
        async function detailsDeleteEvent() {
            if (!confirm("Bu kirlilik ilanını ve tüm katılım kayıtlarını kalıcı olarak silmek istediğinizden emin misiniz?")) {
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const response = await fetch(`/api/events/${EVENT_ID}`, {
                    method: 'DELETE',
                    headers: { 'RequestVerificationToken': token }
                });

                const res = await response.json();
                if (response.ok && res.success) {
                    if (window.showToast) window.showToast(res.message, "success");
                    setTimeout(() => window.location.href = '/', 800);
                } else {
                    if (window.showToast) window.showToast(res.message || "Silinemedi.", "error");
                }
            } catch (e) {
                if (window.showToast) window.showToast("İlan silinirken bir hata oluştu.", "error");
            }
        }

        // Tamamla Modalı
        function openDetailsCompleteModal() {
            const modal = document.getElementById('detailsCompleteModal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
        }

        function closeDetailsCompleteModal() {
            const modal = document.getElementById('detailsCompleteModal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        document.getElementById('detailsCompleteForm')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const photoInput = document.getElementById('detailsAfterPhoto');
            const noteInput = document.getElementById('detailsCompletionNote');
            const submitBtn = document.getElementById('btnSubmitDetailsComplete');
            const alertBox = document.getElementById('detailsCompleteAlert');

            if (!photoInput || !photoInput.files || photoInput.files.length === 0) {
                alertBox.className = 'p-2.5 rounded-xl text-xs font-medium border bg-rose-50 text-rose-700 border-rose-200 block';
                alertBox.textContent = 'Lütfen temizlik kanıt fotoğrafını seçiniz.';
                return;
            }

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i><span>Yükleniyor...</span>';
            if (window.lucide) lucide.createIcons();

            const formData = new FormData();
            formData.append('afterPhoto', photoInput.files[0]);
            formData.append('completionNote', noteInput?.value || '');

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const response = await fetch(`/api/events/${EVENT_ID}/complete`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: formData
                });

                const res = await response.json();
                if (response.ok && res.success) {
                    closeDetailsCompleteModal();
                    if (window.showToast) window.showToast(res.message, "success");
                    setTimeout(() => window.location.reload(), 800);
                } else {
                    alertBox.className = 'p-2.5 rounded-xl text-xs font-medium border bg-rose-50 text-rose-700 border-rose-200 block';
                    alertBox.textContent = res.message || 'Yükleme başarısız.';
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i data-lucide="check" class="w-3.5 h-3.5"></i><span>Temizliği Onayla</span>';
                    if (window.lucide) lucide.createIcons();
                }
            } catch (err) {
                alertBox.className = 'p-2.5 rounded-xl text-xs font-medium border bg-rose-50 text-rose-700 border-rose-200 block';
                alertBox.textContent = 'Sunucu hatası oluştu.';
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i data-lucide="check" class="w-3.5 h-3.5"></i><span>Temizliği Onayla</span>';
                if (window.lucide) lucide.createIcons();
            }
        });

        // Şikayet Modalı
        function openDetailsReportModal() {
            const modal = document.getElementById('detailsReportModal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
        }

        function closeDetailsReportModal() {
            const modal = document.getElementById('detailsReportModal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        document.getElementById('detailsReportForm')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const reason = document.getElementById('detailsReportReason')?.value;
            const desc = document.getElementById('detailsReportDesc')?.value;
            const submitBtn = document.getElementById('btnSubmitDetailsReport');
            const alertBox = document.getElementById('detailsReportAlert');

            if (!reason) return;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i><span>İletiliyor...</span>';
            if (window.lucide) lucide.createIcons();

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const response = await fetch('/api/reports', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        EventId: EVENT_ID,
                        Reason: reason,
                        Description: desc || ''
                    })
                });

                const res = await response.json();
                if (response.ok && res.success) {
                    closeDetailsReportModal();
                    if (window.showToast) window.showToast(res.message, "success");
                } else {
                    alertBox.className = 'p-2.5 rounded-xl text-xs font-medium border bg-rose-50 text-rose-700 border-rose-200 block';
                    alertBox.textContent = res.message || 'Şikayet iletilemedi.';
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i data-lucide="send" class="w-3.5 h-3.5"></i><span>Şikayeti İlet</span>';
                    if (window.lucide) lucide.createIcons();
                }
            } catch (err) {
                alertBox.className = 'p-2.5 rounded-xl text-xs font-medium border bg-rose-50 text-rose-700 border-rose-200 block';
                alertBox.textContent = 'Sunucu hatası oluştu.';
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i data-lucide="send" class="w-3.5 h-3.5"></i><span>Şikayeti İlet</span>';
                if (window.lucide) lucide.createIcons();
            }
        });
    </script>
}
