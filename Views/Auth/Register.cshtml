@model RegisterViewModel
@{
    ViewData["Title"] = "Gönüllü Kaydı";
}

<div class="min-h-[calc(100vh-12rem)] flex items-center justify-center py-6 px-4">
    <div class="w-full max-w-lg bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm p-6 sm:p-8 transition-colors">
        
        <!-- Üst Başlık -->
        <div class="text-center mb-6">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 mx-auto flex items-center justify-center mb-2.5">
                <i data-lucide="user-plus" class="w-5 h-5"></i>
            </div>
            <h1 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">Kampüs İmece'ye Katıl</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Selçuk Üniversitesi çevre gönüllüsü olmak için hesabınızı oluşturun.</p>
        </div>

        <!-- Validasyon Özeti -->
        <div asp-validation-summary="ModelOnly" class="p-3 mb-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 text-xs text-rose-700 dark:text-rose-300 font-medium"></div>

        <!-- Form -->
        <form asp-action="Register" method="post" id="registerForm" class="space-y-4">
            @Html.AntiForgeryToken()

            <!-- Ad Soyad -->
            <div>
                <label asp-for="FullName" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 dark:text-slate-500">
                        <i data-lucide="user" class="w-4 h-4"></i>
                    </span>
                    <input asp-for="FullName" 
                           class="w-full pl-9 pr-3 py-2 bg-slate-50/70 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 focus:bg-white dark:focus:bg-slate-800 transition" 
                           placeholder="Adınız Soyadınız" 
                           required />
                </div>
                <span asp-validation-for="FullName" class="text-[11px] text-rose-600 dark:text-rose-400 mt-0.5 block"></span>
            </div>

            <!-- Öğrenci No & Telefon (2 Kolon) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label asp-for="StudentNumber" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 dark:text-slate-500">
                            <i data-lucide="badge-percent" class="w-4 h-4"></i>
                        </span>
                        <input asp-for="StudentNumber" 
                               class="w-full pl-9 pr-3 py-2 bg-slate-50/70 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 focus:bg-white dark:focus:bg-slate-800 transition" 
                               placeholder="233311070" 
                               required />
                    </div>
                    <span asp-validation-for="StudentNumber" class="text-[11px] text-rose-600 dark:text-rose-400 mt-0.5 block"></span>
                </div>

                <div>
                    <label asp-for="PhoneNumber" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 dark:text-slate-500">
                            <i data-lucide="phone" class="w-4 h-4"></i>
                        </span>
                        <input asp-for="PhoneNumber" 
                               class="w-full pl-9 pr-3 py-2 bg-slate-50/70 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 focus:bg-white dark:focus:bg-slate-800 transition" 
                               placeholder="05xxxxxxxxx" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-[11px] text-rose-600 dark:text-rose-400 mt-0.5 block"></span>
                </div>
            </div>

            <!-- E-posta -->
            <div>
                <label asp-for="Email" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 dark:text-slate-500">
                        <i data-lucide="mail" class="w-4 h-4"></i>
                    </span>
                    <input asp-for="Email" 
                           class="w-full pl-9 pr-3 py-2 bg-slate-50/70 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 focus:bg-white dark:focus:bg-slate-800 transition" 
                           placeholder="numaraniz@ogr.selcuk.edu.tr" 
                           required />
                </div>
                <span asp-validation-for="Email" class="text-[11px] text-rose-600 dark:text-rose-400 mt-0.5 block"></span>
            </div>

            <!-- Şifre & Şifre Tekrar (2 Kolon) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label asp-for="Password" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 dark:text-slate-500">
                            <i data-lucide="lock" class="w-4 h-4"></i>
                        </span>
                        <input asp-for="Password" 
                               type="password" 
                               class="w-full pl-9 pr-3 py-2 bg-slate-50/70 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 focus:bg-white dark:focus:bg-slate-800 transition" 
                               placeholder="••••••••" 
                               required />
                    </div>
                    <span asp-validation-for="Password" class="text-[11px] text-rose-600 dark:text-rose-400 mt-0.5 block"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 dark:text-slate-500">
                            <i data-lucide="check" class="w-4 h-4"></i>
                        </span>
                        <input asp-for="ConfirmPassword" 
                               type="password" 
                               class="w-full pl-9 pr-3 py-2 bg-slate-50/70 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 focus:bg-white dark:focus:bg-slate-800 transition" 
                               placeholder="••••••••" 
                               required />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-[11px] text-rose-600 dark:text-rose-400 mt-0.5 block"></span>
                </div>
            </div>

            <!-- ZORUNLU KVKK ONAY KUTUSU -->
            <div class="pt-1">
                <div id="kvkkConsentCard" class="p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/60 dark:bg-slate-800/50 hover:bg-slate-50 dark:hover:bg-slate-800/80 transition">
                    <div class="flex items-start gap-2.5">
                        <input asp-for="AcceptKvkk" 
                               type="checkbox" 
                               id="acceptKvkkCheckbox" 
                               class="mt-0.5 h-4 w-4 rounded border-slate-300 dark:border-slate-600 text-emerald-600 focus:ring-emerald-500/20 cursor-pointer" />
                        <label for="acceptKvkkCheckbox" class="text-xs text-slate-700 dark:text-slate-300 leading-snug cursor-pointer select-none">
                            6698 sayılı KVKK gereği 
                            <button type="button" onclick="openKvkkModal()" class="text-emerald-700 dark:text-emerald-400 hover:text-emerald-800 dark:hover:text-emerald-300 font-semibold underline focus:outline-none">
                                Aydınlatma Metni ve Açık Rıza Sözleşmesi
                            </button>'ni okudum, kişisel verilerimin güvenle işlenmesini kabul ediyorum. <span class="text-rose-500 font-bold">*</span>
                        </label>
                    </div>
                </div>
                <div id="kvkkErrorMsg" class="hidden text-[11px] text-rose-600 dark:text-rose-400 mt-1.5 flex items-center gap-1 font-medium">
                    <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i>
                    <span>Kayıt olmak için KVKK Aydınlatma Metnini onaylamanız zorunludur.</span>
                </div>
                <span asp-validation-for="AcceptKvkk" class="text-[11px] text-rose-600 dark:text-rose-400 mt-1 block"></span>
            </div>

            <!-- Kayıt Butonu -->
            <button type="submit" 
                    id="btnRegisterSubmit" 
                    class="w-full py-2.5 px-4 rounded-xl text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 transition shadow-sm active:scale-98 flex items-center justify-center gap-2">
                <span>Kayıt Ol</span>
                <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </button>
        </form>

        <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800 text-center text-xs text-slate-500 dark:text-slate-400">
            Zaten hesabınız var mı?
            <a asp-action="Login" class="font-semibold text-emerald-700 dark:text-emerald-400 hover:text-emerald-800 dark:hover:text-emerald-300 ml-1">
                Giriş Yapın
            </a>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- KVKK AYDINLATMA METNİ VE AÇIK RIZA BEYANI MODALI         -->
<!-- ======================================================== -->
<div id="kvkkConsentModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4 overflow-y-auto">
    <div class="relative w-full max-w-xl bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-800 overflow-hidden my-8">
        
        <!-- Modal Başlık -->
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-2">
                <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white">KVKK Aydınlatma Metni & Açık Rıza Sözleşmesi</h3>
            </div>
            <button type="button" onclick="closeKvkkModal()" class="p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-lg transition">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <!-- Bilgi Rozeti -->
        <div class="bg-amber-50 dark:bg-amber-950/40 px-5 py-2.5 border-b border-amber-100/70 dark:border-amber-900/50 flex items-center gap-2 text-xs text-amber-900 dark:text-amber-300 font-medium">
            <i data-lucide="info" class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0"></i>
            <span>Platforma üye olabilmek için bu sözleşmenin onaylanması kanunen zorunludur.</span>
        </div>

        <!-- Modal İçeriği (Kaydırılabilir) -->
        <div class="p-5 space-y-3 max-h-[55vh] overflow-y-auto text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            <div class="p-3 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-100 dark:border-slate-700/60">
                <h4 class="font-semibold text-slate-900 dark:text-white mb-1">1. Veri Sorumlusu</h4>
                <p>Selçuk Üniversitesi Teknoloji Fakültesi Bilgisayar Mühendisliği Topluma Hizmet Uygulamaları Projesi kapsamında "Kampüsİmece" platformudur.</p>
            </div>

            <div class="p-3 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-100 dark:border-slate-700/60">
                <h4 class="font-semibold text-slate-900 dark:text-white mb-1">2. İşlenen Kişisel Veriler ve Amaç</h4>
                <p>Ad, soyad, öğrenci numarası, üniversite e-posta adresi, temizlik etkinliği katılım kayıtları ve saha fotoğrafları; kampüs çevre temizliği imecesinin yürütülmesi ve güvenilirlik puanının hesaplanması amacıyla işlenir.</p>
            </div>

            <div class="p-3 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-100 dark:border-slate-700/60">
                <h4 class="font-semibold text-slate-900 dark:text-white mb-1">3. Güvenlik ve Maskeleme</h4>
                <p>Şifreler PBKDF2 (SHA-256) ve rastgele tuzlama ile 100.000 iterasyonla hash'lenerek saklanır. Öğrenci numaraları kamuya açık liderlik tablosunda otomatik maskelenir (Örn: 2333****). KVKK onayınız SHA-256 denetim özetiyle veritabanında güvenceye alınır.</p>
            </div>

            <div class="p-3 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-100 dark:border-slate-700/60">
                <h4 class="font-semibold text-slate-900 dark:text-white mb-1">4. Açık Rıza Beyanı</h4>
                <p>Yukarıdaki Aydınlatma Metnini okuduğumu, kişisel verilerimin bu çerçevede işlenmesine ve saklanmasına özgür irademle açık rıza verdiğimi beyan ederim.</p>
            </div>
        </div>

        <!-- Modal Butonları -->
        <div class="flex items-center justify-between gap-3 px-5 py-3 bg-slate-50/50 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800">
            <button type="button" onclick="rejectAndCloseKvkkModal()" class="px-3.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                Vazgeç / Reddet
            </button>
            <button type="button" onclick="approveAndCloseKvkkModal()" class="px-4 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-sm transition flex items-center gap-1.5">
                <i data-lucide="check" class="w-3.5 h-3.5"></i>
                <span>Okudum, Anladım ve Onaylıyorum</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const registerForm = document.getElementById('registerForm');
        const acceptKvkkCheckbox = document.getElementById('acceptKvkkCheckbox');
        const kvkkErrorMsg = document.getElementById('kvkkErrorMsg');
        const kvkkConsentCard = document.getElementById('kvkkConsentCard');

        function openKvkkModal() {
            const modal = document.getElementById('kvkkConsentModal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.classList.add('overflow-hidden');
            }
        }

        function closeKvkkModal() {
            const modal = document.getElementById('kvkkConsentModal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.classList.remove('overflow-hidden');
            }
        }

        function approveAndCloseKvkkModal() {
            if (acceptKvkkCheckbox) {
                acceptKvkkCheckbox.checked = true;
                if (kvkkErrorMsg) kvkkErrorMsg.classList.add('hidden');
                if (kvkkConsentCard) {
                    kvkkConsentCard.classList.remove('border-rose-300', 'bg-rose-50/50');
                    kvkkConsentCard.classList.add('border-emerald-300', 'bg-emerald-50/50');
                }
            }
            closeKvkkModal();
            window.showToast("KVKK Aydınlatma Metni onaylandı.", "success");
        }

        function rejectAndCloseKvkkModal() {
            if (acceptKvkkCheckbox) {
                acceptKvkkCheckbox.checked = false;
            }
            if (kvkkErrorMsg) kvkkErrorMsg.classList.remove('hidden');
            if (kvkkConsentCard) {
                kvkkConsentCard.classList.remove('border-emerald-300', 'bg-emerald-50/50');
                kvkkConsentCard.classList.add('border-rose-300', 'bg-rose-50/50');
            }
            closeKvkkModal();
            window.showToast("KVKK sözleşmesini onaylamadan kayıt olamazsınız.", "error");
        }

        // Form submit kontrolü: Değerleri kırp ve KVKK onaylanmadıysa modalı aç ve engelle
        if (registerForm) {
            registerForm.addEventListener('submit', function (e) {
                const inputs = registerForm.querySelectorAll('input[type="text"], input[type="email"], input[type="tel"]');
                inputs.forEach(input => {
                    input.value = input.value.trim();
                });

                if (!acceptKvkkCheckbox || !acceptKvkkCheckbox.checked) {
                    e.preventDefault();
                    if (kvkkErrorMsg) kvkkErrorMsg.classList.remove('hidden');
                    if (kvkkConsentCard) {
                        kvkkConsentCard.classList.add('border-rose-300', 'bg-rose-50/50');
                    }
                    openKvkkModal();
                    return false;
                }
            });
        }

        if (acceptKvkkCheckbox) {
            acceptKvkkCheckbox.addEventListener('change', function () {
                if (this.checked) {
                    if (kvkkErrorMsg) kvkkErrorMsg.classList.add('hidden');
                    if (kvkkConsentCard) {
                        kvkkConsentCard.classList.remove('border-rose-300', 'bg-rose-50/50');
                        kvkkConsentCard.classList.add('border-emerald-300', 'bg-emerald-50/50');
                    }
                } else {
                    if (kvkkErrorMsg) kvkkErrorMsg.classList.remove('hidden');
                    if (kvkkConsentCard) {
                        kvkkConsentCard.classList.remove('border-emerald-300', 'bg-emerald-50/50');
                        kvkkConsentCard.classList.add('border-rose-300', 'bg-rose-50/50');
                    }
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (window.lucide) lucide.createIcons();
        });
    </script>
}
